# Example only. Missing mode never enables demo. No credentials included.
DESIGNMELA_MODE=connected
DESIGNMELA_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
DESIGNMELA_ORGANIZATION_ID=REPLACE_WITH_APPROVED_ORGANIZATION_UUID
SUPABASE_DEV_PROJECT_CONFIRMED=true
INITIAL_OWNER_BOOTSTRAP_ENABLED=false

# Vercel Preview: DESIGNMELA_ENV=preview; bootstrap false; development project
# confirmation true. Omit NEXT_PUBLIC_APP_URL to derive the HTTPS branch URL
# (or deployment URL), or set that exact approved Vercel URL. Never use the final
# production URL in Preview scope.
# Production: DESIGNMELA_ENV=production; NEXT_PUBLIC_APP_URL must be
# https://dashboard.designmela.com. Omit SUPABASE_DEV_PROJECT_CONFIRMED and use
# the separately approved production Supabase URL/key and organization.
# Do not override NODE_ENV, VERCEL_ENV, VERCEL_URL or VERCEL_BRANCH_URL.
# Explicit local demo: DESIGNMELA_MODE=demo, DESIGNMELA_ENV=development,
# run next dev. Hosted deployments and next start cannot enable demo.

# Local administration ONLY; never upload these to Vercel:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# INITIAL_OWNER_EMAIL=owner@example.invalid
# DESIGNMELA_APP_ORIGIN is a deprecated LOCAL-only alias for NEXT_PUBLIC_APP_URL.
# No service-role, secret API key or legacy anon key is needed by the runtime.
# N8N_BASE_URL, N8N_API_KEY, N8N_WEBHOOK_SECRET and WEBSITE_ALLOWED_ORIGINS are
# unused/unfinished integrations; leave unset for Phase 4.
