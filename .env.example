# No variables or credentials are needed for Demo Mode.
DESIGNMELA_MODE=demo
# Connected development only: keep disabled until migration and setup approval.
# DESIGNMELA_ENV=development
# SUPABASE_DEV_PROJECT_CONFIRMED=true
# DESIGNMELA_ORGANIZATION_ID=UUID_FROM_APPROVED_BOOTSTRAP
# Server-only database administration/validation connection; never use NEXT_PUBLIC_.
# DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@HOST:5432/postgres
# Public-safe client configuration; not sufficient to enable Connected Mode:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# This is the sole supported public-key variable; no legacy anon key is needed.
# Server-only future integrations. NEVER prefix these with NEXT_PUBLIC_.
# A privileged credential is not needed for Phase 2A read-only/local validation.
# SUPABASE_SERVICE_ROLE_KEY=  # future approved bootstrap operation only
# Bootstrap-only server variables. Enable briefly AFTER explicit migration approval.
# INITIAL_OWNER_EMAIL=
# INITIAL_OWNER_BOOTSTRAP_ENABLED=false
# N8N_BASE_URL=
# N8N_API_KEY=
# N8N_WEBHOOK_SECRET=
# Future website ingestion allowlist (endpoint still returns 503 until storage exists):
# WEBSITE_ALLOWED_ORIGINS=https://your-approved-site.example
